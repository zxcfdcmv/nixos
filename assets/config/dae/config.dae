# assets/config/dae/config.dae
global {
  lan_interface: auto
  wan_interface: auto
  log_level: warn
  dial_mode: ip
  check_interval: 30s
  allow_insecure: true
}

subscription {
  'https://d.zrfme.com/vless-base64'
  # 'https://cdn.jsdelivr.net/gh/chengaopan/AutoMergePublicNodes@master/list.txt'
  # 'https://gh-proxy.org/https://raw.githubusercontent.com/free-nodes/v2rayfree/main/sub'
  # 'https://gh-proxy.org/raw.githubusercontent.com/free18/v2ray/refs/heads/main/v.txt'
  # 'https://gh-proxy.org/raw.githubusercontent.com/snakem982/proxypool/main/source/v2ray-2.txt'

  # all: 'https://gh-proxy.org/github.com/zxcfdcmv/notes/releases/download/latest/all_nodes.txt'
  # g443: 'https://gh-proxy.org/github.com/zxcfdcmv/notes/releases/download/latest/clean_443_nodes.txt'
}

dns {
  upstream {
    alidns: 'udp://223.5.5.5:53'
    googledns: 'tcp+udp://8.8.8.8:53'
  }
  routing {
    request {
      qname(geosite:cn) -> alidns
      qname(geosite:google,geosite:telegram,geosite:github) -> googledns
      fallback: alidns
    }
    response {
      upstream(alidns) && !ip(geoip:cn) -> googledns
      fallback: accept
    }
  }
}

group {
  proxy {
    # filter: subtag(all)
    policy: min_moving_avg
  }

  # google_proxy {
  #   filter: subtag(g443)
  #   policy: min_moving_avg
  # }
}

routing {
  pname(dae) -> must_direct

  pname(NetworkManager, systemd, dhclient) -> direct

  # domain(geosite:google) -> google_proxy

  domain(getcroc.com) -> direct
  domain(cowyo.com) -> direct
  domain(cn.bing.com) -> direct

  domain(geosite:cn) -> direct
  domain(keyword:gh-proxy) -> direct
  domain(keyword:steamstatic) -> direct
  dip(geoip:private) -> direct
  dip(geoip:cn) -> direct

  domain(keyword:steamcommunity,steampowered) -> proxy
  domain(geosite:telegram,geosite:github) -> proxy

  fallback: proxy
}
